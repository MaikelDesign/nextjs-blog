{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node './src/utils/generate-sitemap.js' && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint './src/**/style.js'",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings 15 --config .eslintrc.test.js src test",
    "prettier:fix": "prettier --write '**/*.{js,jsx,css,scss}'",
    "fix:all": "yarn run lint:css && yarn run prettier:fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.19.0",
    "cwd": "^0.10.0",
    "date-fns": "^4.4.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "xml2js": "^0.6.2"
  },
  "resolutions": {
    "styled-components": "^6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-processor-styled-components": "^1.10.0",
    "tailwindcss": "^4.3.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ],
    "style.{js,jsx,ts,tsx}": [
      "stylelint --fix",
      "git add"
    ]
  }
}
